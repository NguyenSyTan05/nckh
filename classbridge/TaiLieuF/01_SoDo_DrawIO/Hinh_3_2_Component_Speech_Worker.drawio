  <diagram id="Hinh_3_2_Component_Speech_Worker" name="Hình 3.2 - Speech Worker">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="b_stt" value="&lt;div style=&quot;line-height:1.25;text-align:left;&quot;&gt;&lt;b style=&quot;font-size:13.5px;color:#222222;&quot;&gt;Speech Processing Worker&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#555555;&quot;&gt;[Container: Isolated Python Worker]&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=bottom;spacingLeft=14;spacingBottom=10;fillColor=none;strokeColor=#555555;strokeWidth=2;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="350" y="70" width="900" height="740" as="geometry" />
        </mxCell>
        <mxCell id="AudioInput" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;&lt;b style=&quot;font-size:13.5px;&quot;&gt;Task Queue (Audio Stream)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;opacity:0.85;&quot;&gt;[Container: Async Queue]&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11.5px;&quot;&gt;Cung cấp các đoạn âm thanh&lt;br/&gt;cắt ngắn (3–5 giây) từ giảng viên&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;fontFamily=Segoe UI;rounded=1;arcSize=6;fillColor=#f8f6f6;strokeColor=#6b5b57;strokeWidth=2.2;fontColor=#3b2f2c;" vertex="1" parent="1">
          <mxGeometry x="25" y="120" width="265" height="150" as="geometry" />
        </mxCell>
        <mxCell id="WSOutput" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;&lt;b style=&quot;font-size:13.5px;&quot;&gt;WebSocket Broadcast Engine&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;opacity:0.85;&quot;&gt;[Container: FastAPI Server]&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11.5px;&quot;&gt;Nhận phụ đề song ngữ để đẩy&lt;br/&gt;lên màn chiếu &amp;amp; điện thoại&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;fontFamily=Segoe UI;rounded=1;arcSize=6;fillColor=#f8f6f6;strokeColor=#6b5b57;strokeWidth=2.2;fontColor=#3b2f2c;" vertex="1" parent="1">
          <mxGeometry x="1310" y="365" width="265" height="150" as="geometry" />
        </mxCell>
        <mxCell id="AudioConsumer" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;&lt;b style=&quot;font-size:13.5px;&quot;&gt;Audio Stream Consumer&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;opacity:0.85;&quot;&gt;[Component: Async Worker]&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11.5px;&quot;&gt;Nhận Audio Chunk (3–5s) và&lt;br/&gt;chuẩn hóa tần số lấy mẫu 16kHz&lt;/span&gt;&lt;/div&gt;" style="shape=folder;fontStyle=0;tabWidth=70;tabHeight=16;tabPosition=left;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacingTop=14;fillColor=#f2f7fc;strokeColor=#2b6cb0;strokeWidth=2.2;fontColor=#163a5f;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="400" y="120" width="290" height="150" as="geometry" />
        </mxCell>
        <mxCell id="VADGate" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;&lt;b style=&quot;font-size:13.5px;&quot;&gt;VAD Audio Gate&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;opacity:0.85;&quot;&gt;[Component: Silero VAD]&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11.5px;&quot;&gt;Phát hiện giọng nói giảng viên,&lt;br/&gt;ngắt luồng khi im lặng chống ảo giác&lt;/span&gt;&lt;/div&gt;" style="shape=folder;fontStyle=0;tabWidth=70;tabHeight=16;tabPosition=left;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacingTop=14;fillColor=#f2f7fc;strokeColor=#2b6cb0;strokeWidth=2.2;fontColor=#163a5f;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="910" y="120" width="290" height="150" as="geometry" />
        </mxCell>
        <mxCell id="WhisperEngine" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;&lt;b style=&quot;font-size:13.5px;&quot;&gt;&amp;gt;_ STT Inference Engine&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;opacity:0.85;&quot;&gt;[Component: Faster-Whisper]&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11.5px;&quot;&gt;Chuyển đổi giọng nói tiếng Anh&lt;br/&gt;sang văn bản với độ trễ thấp&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;fontFamily=Segoe UI;rounded=1;arcSize=6;fillColor=#f2f7fc;strokeColor=#2b6cb0;strokeWidth=2.2;fontColor=#163a5f;" vertex="1" parent="1">
          <mxGeometry x="400" y="365" width="290" height="150" as="geometry" />
        </mxCell>
        <mxCell id="TermTranslator" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;&lt;b style=&quot;font-size:13.5px;&quot;&gt;&amp;gt;_ Bilingual Translator&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;opacity:0.85;&quot;&gt;[Component: NLLB / MarianMT]&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11.5px;&quot;&gt;Dịch phụ đề tiếng Anh sang tiếng Việt,&lt;br/&gt;bảo toàn thuật ngữ chuyên ngành IT&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;fontFamily=Segoe UI;rounded=1;arcSize=6;fillColor=#f2f7fc;strokeColor=#2b6cb0;strokeWidth=2.2;fontColor=#163a5f;" vertex="1" parent="1">
          <mxGeometry x="910" y="365" width="290" height="150" as="geometry" />
        </mxCell>
        <mxCell id="MemoryGuard" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;&lt;b style=&quot;font-size:13.5px;&quot;&gt;Worker Health &amp;amp; Memory Guard&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;opacity:0.85;&quot;&gt;[Component: Fault Supervisor]&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11.5px;&quot;&gt;Giám sát tràn bộ nhớ (OOM)&lt;br/&gt;&amp;amp; tự khởi động lại STT ≤ 5s&lt;/span&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=14;spacingBottom=6;fillColor=#f2f7fc;strokeColor=#2b6cb0;strokeWidth=2.2;fontColor=#163a5f;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="400" y="605" width="290" height="150" as="geometry" />
        </mxCell>
        <mxCell id="TranscriptStore" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;&lt;b style=&quot;font-size:13.5px;&quot;&gt;Transcript Buffer&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;opacity:0.85;&quot;&gt;[Component: Batch Writer]&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11.5px;&quot;&gt;Đệm bản ghi lời giảng kèm&lt;br/&gt;dấu thời gian (Timestamp)&lt;/span&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=14;spacingBottom=6;fillColor=#f2f7fc;strokeColor=#2b6cb0;strokeWidth=2.2;fontColor=#163a5f;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="910" y="605" width="290" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PostgresDB" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;&lt;b style=&quot;font-size:13.5px;&quot;&gt;Primary Database&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;opacity:0.85;&quot;&gt;[Container: PostgreSQL]&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11.5px;&quot;&gt;Lưu trữ toàn bộ bản ghi&lt;br/&gt;lời giảng phục vụ báo cáo&lt;/span&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=14;spacingBottom=6;fillColor=#f2f7fc;strokeColor=#2b6cb0;strokeWidth=2.2;fontColor=#163a5f;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="910" y="870" width="290" height="145" as="geometry" />
        </mxCell>
        <mxCell id="edge_1" value="&lt;div style=&quot;background:#ffffff;padding:1px 4px;line-height:1.2;&quot;&gt;&lt;span style=&quot;font-size:11px;color:#333333;font-weight:600;&quot;&gt;1. Đẩy Audio Chunk (3-5s)&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;color:#555555;&quot;&gt;[Async Worker Task]&lt;/span&gt;&lt;/div&gt;" style="edgeStyle=none;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.8;dashed=1;dashPattern=6 5;endArrow=block;endFill=1;endSize=7;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="AudioInput" target="AudioConsumer">
