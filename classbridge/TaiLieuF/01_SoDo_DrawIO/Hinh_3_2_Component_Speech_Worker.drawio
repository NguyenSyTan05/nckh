        <mxCell id="edge_4" value="&lt;div style=&quot;background:#ffffff;padding:1px 4px;line-height:1.2;&quot;&gt;&lt;span style=&quot;font-size:11px;color:#333333;font-weight:600;&quot;&gt;4. Văn bản tiếng Anh&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;color:#555555;&quot;&gt;[Raw Transcript]&lt;/span&gt;&lt;/div&gt;" style="edgeStyle=none;rounded=0;html=1;strokeColor=#666666;strokeWidth=1.8;dashed=1;dashPattern=6 5;endArrow=block;endFill=1;endSize=7;fontFamily=Segoe UI;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="WhisperEngine" target="TermTranslator">
