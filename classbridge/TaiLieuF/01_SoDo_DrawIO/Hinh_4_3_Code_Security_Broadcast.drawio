        <mxCell id="b_code_sec" value="&lt;div style=&quot;line-height:1.25;text-align:left;&quot;&gt;&lt;b style=&quot;font-size:13.5px;color:#222222;&quot;&gt;Security &amp;amp; 1-to-Many Broadcast Module&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#555555;&quot;&gt;[Code Boundary: FR-01, FR-04 &amp;amp; QA 1.3, 3.1, 3.2, 3.3]&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=bottom;spacingLeft=14;spacingBottom=10;fillColor=none;strokeColor=#555555;strokeWidth=2;fontFamily=Segoe UI;" vertex="1" parent="1">
