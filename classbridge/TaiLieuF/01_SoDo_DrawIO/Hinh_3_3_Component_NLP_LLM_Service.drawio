        <mxCell id="TextNorm" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;&lt;b style=&quot;font-size:13.5px;&quot;&gt;Multilingual Text Normalizer&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;opacity:0.85;&quot;&gt;[Component: Preprocessor]&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11.5px;&quot;&gt;Chuẩn hóa câu hỏi tiếng Việt, Anh&lt;br/&gt;&amp;amp; pha trộn thuật ngữ (Code-switching)&lt;/span&gt;&lt;/div&gt;" style="shape=folder;fontStyle=0;tabWidth=70;tabHeight=16;tabPosition=left;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacingTop=14;fillColor=#f2f7fc;strokeColor=#2b6cb0;strokeWidth=2.2;fontColor=#163a5f;fontFamily=Segoe UI;" vertex="1" parent="1">
