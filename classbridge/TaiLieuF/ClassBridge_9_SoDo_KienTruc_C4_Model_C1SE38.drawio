        <mxCell id="QuestionInput" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;&lt;b style=&quot;font-size:13.5px;&quot;&gt;Session &amp;amp; QnA Controller&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;opacity:0.85;&quot;&gt;[Container: FastAPI Backend]&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11.5px;&quot;&gt;Gửi câu hỏi ẩn danh mới &amp;amp;&lt;br/&gt;yêu cầu tổng kết cuối buổi&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;fontFamily=Segoe UI;rounded=1;arcSize=6;fillColor=#f8f6f6;strokeColor=#6b5b57;strokeWidth=2.2;fontColor=#3b2f2c;" vertex="1" parent="1">
          <mxGeometry x="25" y="240" width="265" height="155" as="geometry" />
        </mxCell>
        <mxCell id="DashboardOut" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;&lt;b style=&quot;font-size:13.5px;&quot;&gt;Lecturer Dashboard&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;opacity:0.85;&quot;&gt;[Container: Next.js UI]&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11.5px;&quot;&gt;Hiển thị danh sách cụm câu hỏi&lt;br/&gt;nóng nhất &amp;amp; biểu đồ Heatmap&lt;/span&gt;&lt;/div&gt;" style="shape=mxgraph.c4.webBrowserContainer2;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingTop=22;spacingLeft=8;spacingRight=8;fillColor=#f2f7fc;strokeColor=#2b6cb0;strokeWidth=2.2;fontColor=#163a5f;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1310" y="365" width="265" height="150" as="geometry" />
        </mxCell>
        <mxCell id="TextNorm" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;&lt;b style=&quot;font-size:13.5px;&quot;&gt;Multilingual Text Normalizer&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;opacity:0.85;&quot;&gt;[Component: Preprocessor]&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11.5px;&quot;&gt;Chuẩn hóa câu hỏi tiếng Việt, Anh&lt;br/&gt;&amp;amp; pha trộn thuật ngữ (Code-switching)&lt;/span&gt;&lt;/div&gt;" style="shape=folder;fontStyle=0;tabWidth=70;tabHeight=16;tabPosition=left;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacingTop=14;fillColor=#f2f7fc;strokeColor=#2b6cb0;strokeWidth=2.2;fontColor=#163a5f;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="400" y="120" width="290" height="150" as="geometry" />
        </mxCell>
        <mxCell id="EmbedAdapter" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;&lt;b style=&quot;font-size:13.5px;&quot;&gt;Embedding Model Adapter&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;opacity:0.85;&quot;&gt;[Component: Strategy Pattern]&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11.5px;&quot;&gt;Trích xuất vector ngữ nghĩa 768 chiều&lt;br/&gt;(Hỗ trợ đổi e5-base / LaBSE)&lt;/span&gt;&lt;/div&gt;" style="shape=folder;fontStyle=0;tabWidth=70;tabHeight=16;tabPosition=left;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacingTop=14;fillColor=#f2f7fc;strokeColor=#2b6cb0;strokeWidth=2.2;fontColor=#163a5f;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="910" y="120" width="290" height="150" as="geometry" />
        </mxCell>
        <mxCell id="LLMSummarizer" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;&lt;b style=&quot;font-size:13.5px;&quot;&gt;&amp;gt;_ Unified LLM Summarizer&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;opacity:0.85;&quot;&gt;[Component: Qwen2.5-7B / Ollama]&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11.5px;&quot;&gt;Tổng hợp nội dung bài giảng cuối buổi&lt;br/&gt;&amp;amp; tính toán Comprehension Heatmap&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;fontFamily=Segoe UI;rounded=1;arcSize=6;fillColor=#f2f7fc;strokeColor=#2b6cb0;strokeWidth=2.2;fontColor=#163a5f;" vertex="1" parent="1">
          <mxGeometry x="400" y="365" width="290" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ClusterEngine" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;&lt;b style=&quot;font-size:13.5px;&quot;&gt;&amp;gt;_ Semantic Clustering Engine&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;opacity:0.85;&quot;&gt;[Component: Cosine Similarity]&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11.5px;&quot;&gt;So khớp vector với tâm cụm hiện tại,&lt;br/&gt;gộp cụm hoặc tạo mới trong ≤ 500ms&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;fontFamily=Segoe UI;rounded=1;arcSize=6;fillColor=#f2f7fc;strokeColor=#2b6cb0;strokeWidth=2.2;fontColor=#163a5f;" vertex="1" parent="1">
