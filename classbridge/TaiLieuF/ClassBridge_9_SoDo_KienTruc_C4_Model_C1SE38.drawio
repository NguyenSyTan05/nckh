        <mxCell id="LecturerUI" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;&lt;b style=&quot;font-size:13.5px;&quot;&gt;Lecturer Dashboard&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;opacity:0.85;&quot;&gt;[Container: Next.js / React]&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11.5px;&quot;&gt;Giao diện thu âm bài giảng, quản lý&lt;br/&gt;cụm câu hỏi, trả lời 1-nhiều&lt;br/&gt;&amp;amp; xem Comprehension Heatmap&lt;/span&gt;&lt;/div&gt;" style="shape=mxgraph.c4.webBrowserContainer2;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingTop=22;spacingLeft=8;spacingRight=8;fillColor=#f2f7fc;strokeColor=#2b6cb0;strokeWidth=2.2;fontColor=#163a5f;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="820" y="325" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="Backend" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;&lt;b style=&quot;font-size:13.5px;&quot;&gt;&amp;gt;_ Backend API &amp;amp; WebSocket&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;opacity:0.85;&quot;&gt;[Container: Python / FastAPI]&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11.5px;&quot;&gt;Quản lý phiên học, xác thực PIN/JWT,&lt;br/&gt;chống Spam (Rate Limit ≤ 20ms) &amp;amp;&lt;br/&gt;Broadcast thời gian thực (≤ 400ms)&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;fontFamily=Segoe UI;rounded=1;arcSize=6;fillColor=#f2f7fc;strokeColor=#2b6cb0;strokeWidth=2.2;fontColor=#163a5f;" vertex="1" parent="1">
          <mxGeometry x="595" y="585" width="330" height="160" as="geometry" />
        </mxCell>
