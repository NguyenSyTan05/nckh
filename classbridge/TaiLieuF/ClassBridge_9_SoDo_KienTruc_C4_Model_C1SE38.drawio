          <mxGeometry x="405" y="845" width="290" height="155" as="geometry" />
        </mxCell>
        <mxCell id="PostgresDB" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;&lt;b style=&quot;font-size:13.5px;&quot;&gt;Primary Database&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;opacity:0.85;&quot;&gt;[Container: PostgreSQL]&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11.5px;&quot;&gt;Lưu trữ phiên học, transcript,&lt;br/&gt;cụm câu hỏi (Anonymous_Hash_ID)&lt;br/&gt;và báo cáo tổng kết&lt;/span&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=14;spacingBottom=6;fillColor=#f2f7fc;strokeColor=#2b6cb0;strokeWidth=2.2;fontColor=#163a5f;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="825" y="845" width="290" height="155" as="geometry" />
        </mxCell>
        <mxCell id="STTWorker" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;&lt;b style=&quot;font-size:13.5px;&quot;&gt;Speech Processing Worker&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;opacity:0.85;&quot;&gt;[Container: Silero VAD + Faster-Whisper]&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11.5px;&quot;&gt;Tiến trình cô lập (Worker Isolation):&lt;br/&gt;Lọc khoảng lặng, nhận diện giọng nói&lt;br/&gt;tiếng Anh &amp;amp; dịch sang tiếng Việt&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;fontFamily=Segoe UI;rounded=1;arcSize=6;fillColor=#f8f6f6;strokeColor=#6b5b57;strokeWidth=2.2;fontColor=#3b2f2c;" vertex="1" parent="1">
