        <mxCell id="ClassBridge" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;&lt;b style=&quot;font-size:13.5px;&quot;&gt;ClassBridge System&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;opacity:0.85;&quot;&gt;[Software System: Self-hosted AI]&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11.5px;&quot;&gt;Trợ lý AI tự triển khai cục bộ hỗ trợ phụ đề&lt;br/&gt;song ngữ thời gian thực (≤ 1.5s), gom cụm câu hỏi&lt;br/&gt;đa ngôn ngữ (≤ 500ms) &amp;amp; tổng hợp báo cáo EMI&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;fontFamily=Segoe UI;rounded=1;arcSize=6;fillColor=#f2f7fc;strokeColor=#2b6cb0;strokeWidth=2.2;fontColor=#163a5f;" vertex="1" parent="1">
