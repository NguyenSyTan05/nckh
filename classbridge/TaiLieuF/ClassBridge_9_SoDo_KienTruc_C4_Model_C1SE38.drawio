      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="b_nlp" value="&lt;div style=&quot;line-height:1.25;text-align:left;&quot;&gt;&lt;b style=&quot;font-size:13.5px;color:#222222;&quot;&gt;NLP &amp;amp; LLM Inference Service&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11px;color:#555555;&quot;&gt;[Container: Self-hosted AI Service]&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=bottom;spacingLeft=14;spacingBottom=10;fillColor=none;strokeColor=#555555;strokeWidth=2;fontFamily=Segoe UI;" vertex="1" parent="1">
