        </mxCell>
        <mxCell id="NLPWorker" value="&lt;div style=&quot;line-height:1.3;&quot;&gt;&lt;b style=&quot;font-size:13.5px;&quot;&gt;NLP &amp;amp; LLM Inference Service&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10.5px;opacity:0.85;&quot;&gt;[Container: multilingual-e5-base + Qwen]&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;font-size:11.5px;&quot;&gt;Trích xuất vector 768 chiều, gom cụm&lt;br/&gt;Cosine Similarity (≤ 500ms) &amp;amp;&lt;br/&gt;tổng hợp báo cáo cuối buổi&lt;/span&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=6;spacingBottom=6;fontFamily=Segoe UI;rounded=1;arcSize=6;fillColor=#f8f6f6;strokeColor=#6b5b57;strokeWidth=2.2;fontColor=#3b2f2c;" vertex="1" parent="1">
