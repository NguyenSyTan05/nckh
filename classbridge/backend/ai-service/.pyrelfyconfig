[project]
# Pyrefly configuration for ai-service
# Suppress type errors from dynamic ML libraries (torch, transformers, faster-whisper)
# These libraries use a lot of dynamic attribute access that static analysis can't resolve.

[check]
# Don't fail on missing stubs for ML packages
ignore_missing_imports = true
# Allow dynamic attribute access on Any-typed objects
strict = false

[ignore]
# These paths are excluded from type checking
paths = [
  ".venv",
  "__pycache__",
  ".models",
]
